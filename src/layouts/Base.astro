---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { localePath } from '../lib/site';
import Hud from '../components/Hud.astro';
import CookieNotice from '../components/CookieNotice.astro';
// The two faces the hero paints with. Without the preload the browser only
// discovers them after the CSS parses, swaps mid-paint, and reflows the hero
// (measured: CLS 0.26 → see the 0.3 FINDINGS).
import iceland from '../../design-system/assets/fonts/iceland-400.woff2?url';
import body400 from '../../design-system/assets/fonts/chakra-petch-400.woff2?url';
import body400i from '../../design-system/assets/fonts/chakra-petch-400-italic.woff2?url';
import body500 from '../../design-system/assets/fonts/chakra-petch-500.woff2?url';

interface Props {
  title: string;
  description: string;
  /** og:image, relative to the site root. */
  image?: string;
  /** Keep the page out of search results (the design-system parity route). */
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const lang = Astro.currentLocale ?? 'en';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const path = localePath(Astro.url.pathname);
---
<!doctype html>
<html lang={lang} data-hmc-theme="phosphor">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    {[iceland, body400, body400i, body500].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* Both locales are the same page in two languages — say so, once, here. */}
    {!noindex && ['en', 'de', 'x-default'].map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(getRelativeLocaleUrl(l === 'de' ? 'de' : 'en', path), canonical).href}
      />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, canonical)} />}
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Hud />
    <slot />
    <CookieNotice />
  </body>
</html>

<style is:global>
  /* The prototype sets these on its own wrapper div; the site has a real body. */
  body {
    background: var(--void);
    color: var(--text-hi);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  a { color: var(--accent); }
  a:hover { color: var(--chroma-cyan); }

  /* About v2's section rhythm, applied site-wide: hairline between sections,
     cyan instrument eyebrows. */
  main > section + section { border-top: 1px solid var(--line-mid); }
  main section .hmc-label { font-size: 10px; letter-spacing: 0.28em; color: var(--chroma-cyan); }

  /* About v2's hero headline: a chromatic twitch every nine seconds. */
  .hmc-jitter { animation: hmc-jitter 9s steps(1, end) infinite; }
  @keyframes hmc-jitter {
    0%, 88%, 100% { text-shadow: none; transform: translate(0, 0); }
    89% { text-shadow: 2px 0 var(--chroma-magenta), -2px 0 var(--chroma-cyan); transform: translate(-1px, 0); }
    91% { text-shadow: -3px 0 var(--chroma-magenta), 3px 0 var(--chroma-cyan); transform: translate(1px, 0); }
    93% { text-shadow: 1px 0 var(--chroma-cyan); transform: translate(0, 1px); }
  }
  @media (prefers-reduced-motion: reduce) { .hmc-jitter { animation: none; } }
</style>
