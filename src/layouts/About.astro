---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GlitchText from '../components/GlitchText.astro';
import Backdrop from '../components/Backdrop.astro';
import Dossier from '../components/Dossier.astro';
import portrait from '../../design-system/assets/founder-marcus-roeper.jpg';

// Both /about and /de/about render this file; only the entry differs.
const lang = Astro.currentLocale === 'de' ? 'de' : 'en';
const entry = await getEntry('about', lang);
if (!entry) throw new Error(`Missing src/content/about/${lang}.md`);
const { hero, founder, partners, contact } = entry.data;

// A partner's `logo` names a file in design-system/assets/; unknown → build error.
const logos = import.meta.glob<ImageMetadata>('../../design-system/assets/partner-*.png', {
  eager: true,
  import: 'default',
});
const logo = (file: string) => {
  const img = logos[`../../design-system/assets/${file}`];
  if (!img) throw new Error(`Missing design-system/assets/${file}`);
  return img;
};
---
<Base title={entry.data.title} description={entry.data.description} image="/assets/og-cover.png">
  <Nav />

  <main>
  <section id="top" class="hero">
    <Backdrop />
    <div class="inner">
      <Dossier num="04">{hero.eyebrow}</Dossier>
      <div class="hero-grid">
        <div>
          <GlitchText as="h1" class="hero-h1 hmc-jitter">
            {hero.headline}{' '}<span class="accent">{hero.headlineAccent}</span>
          </GlitchText>
          <p class="lede">{hero.lede} <em>{hero.ledeEm}</em></p>
          <p class="founder"><span>{founder.label}</span>{founder.body}</p>
        </div>

        {/* About v2's "Cyberbrain" portrait: the photo, a cyan mesh, and a
            thresholded copy revealed by a sweeping scan band. */}
        <figure class="scan" data-par="8">
          <span class="scan-tag" aria-hidden="true">Cyberbrain · Scan 04</span>
          <div class="frame">
            <Image class="photo" src={portrait} width={430} densities={[1, 2]} alt="Marcus Röper" loading="eager" />
            <div class="mesh" aria-hidden="true"></div>
            <div class="cloud" aria-hidden="true">
              <Image class="photo" src={portrait} width={430} densities={[1, 2]} alt="" loading="eager" />
              <div class="dots"></div>
            </div>
            <div class="sweep" aria-hidden="true"></div>
            <span class="br tl" aria-hidden="true"></span>
            <span class="br tr" aria-hidden="true"></span>
            <span class="br bl" aria-hidden="true"></span>
            <span class="br brr" aria-hidden="true"></span>
            <div class="shade" aria-hidden="true"></div>
            <div class="id" aria-hidden="true"><span>ID · RÖPER, M.</span><span class="low">MATCH 0.998</span></div>
            <div class="ghost" aria-hidden="true">GHOST-LINE STABIL</div>
            <figcaption>
              <span class="name">MARCUS RÖPER</span>
              <span class="role">{hero.role}</span>
            </figcaption>
          </div>
          <span class="corner c1" aria-hidden="true"></span>
          <span class="corner c2" aria-hidden="true"></span>
        </figure>
      </div>
    </div>
  </section>

  <section id="partners" class="partners">
    <div class="inner">
      <div class="section-head">
        <div>
          <div class="hmc-label">{partners.eyebrow}</div>
          <GlitchText as="h2" class="h2">{partners.heading}</GlitchText>
        </div>
        <p class="aside">{partners.aside}</p>
      </div>
      <ul class="partner-grid">
        {partners.items.map((p) => (
          <li>
            <a href={p.href} rel="noopener" target="_blank">
              <span class="tick" aria-hidden="true"></span>
              <div class="logo">
                {p.logo
                  ? <Image src={logo(p.logo)} height={72} densities={[1, 2]} alt="" />
                  : <span>{p.name}</span>}
              </div>
              <div>
                <div class="kicker accent">{p.category}</div>
                <h3>{p.name}</h3>
                <p>{p.body}</p>
              </div>
              <span class="visit">{partners.visit}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="contact" class="contact">
    <Backdrop variant="center" />
    <div class="inner split">
      <div>
        <div class="hmc-label">{contact.eyebrow}</div>
        <GlitchText as="h2" class="h2">{contact.heading}</GlitchText>
      </div>
      <dl class="where">
        <div><dt>{contact.locationLabel}</dt><dd>{contact.location}</dd></div>
        <div><dt>LinkedIn</dt><dd><a href={contact.linkedin} rel="noopener" target="_blank">marcus-roeper</a></dd></div>
        <div><dt>E-Mail</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
      </dl>
    </div>
  </section>
  </main>

  <Footer />
</Base>

<style>
  .inner { max-width: var(--maxw-wide); margin: 0 auto; padding: var(--sp-9) var(--sp-6); }
  .hmc-label { margin-bottom: 14px; }
  .h2 { font-size: var(--fs-h2); line-height: 0.95; max-width: 16ch; margin: 0; }
  .accent { color: var(--accent); }
  .split { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: var(--sp-7); align-items: start; }
  dl, dd, ul { margin: 0; padding: 0; }
  ul { list-style: none; }

  /* ── hero ───────────────────────────────────────────────── */
  .hero { position: relative; overflow: hidden; background: var(--field-glow), var(--void); }
  .hero .inner { position: relative; z-index: 2; padding-bottom: var(--sp-8); }
  .hero-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: var(--sp-7); align-items: end; }
  .hero-h1 { font-size: var(--fs-hero); line-height: 0.86; letter-spacing: -0.01em; max-width: 15ch; }
  .lede {
    font-family: var(--font-serif);
    border-left: 1px solid var(--line-accent);
    padding-left: 10px;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    line-height: 1.3;
    color: var(--text-mid);
    max-width: 40ch;
    margin: var(--sp-6) 0 0;
  }
  .lede em { font-style: italic; color: var(--violet-200); }
  .founder { margin: var(--sp-5) 0 0; color: var(--text-mid); max-width: 52ch; }
  .founder span {
    display: block; margin-bottom: 6px;
    font: 9px var(--font-mono); letter-spacing: 0.28em; text-transform: uppercase; color: var(--text-faint);
  }

  .scan { margin: 0; position: relative; justify-self: end; width: 100%; max-width: 430px; }
  .scan-tag {
    position: absolute; left: -24px; top: 0; bottom: 0; writing-mode: vertical-rl;
    font: 9px var(--font-mono); letter-spacing: 0.34em; text-transform: uppercase; color: var(--chroma-cyan); opacity: 0.75;
  }
  .frame {
    position: relative; overflow: hidden; background: var(--surface-1);
    border: 1px solid color-mix(in oklab, var(--chroma-cyan) 45%, transparent);
    box-shadow: 0 0 40px -14px color-mix(in oklab, var(--chroma-cyan) 50%, transparent);
  }
  .frame :global(.photo) {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 22%;
    filter: saturate(0.55) contrast(1.12) brightness(0.92);
  }
  .mesh {
    position: absolute; inset: 0; mix-blend-mode: screen; opacity: 0.5;
    background-image:
      linear-gradient(color-mix(in oklab, var(--chroma-cyan) 30%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--chroma-cyan) 30%, transparent) 1px, transparent 1px);
    background-size: 15px 15px;
    mask-image: radial-gradient(70% 55% at 50% 34%, #000 0%, transparent 78%);
  }
  .cloud { position: absolute; inset: 0; overflow: hidden; animation: ab-scanband 6.2s var(--ease-in-out, cubic-bezier(0.5, 0, 0.5, 1)) infinite; }
  .cloud :global(.photo) { filter: grayscale(1) contrast(2.4) brightness(0.7) sepia(1) hue-rotate(130deg) saturate(4); }
  .dots {
    position: absolute; inset: 0; mix-blend-mode: screen; background-size: 5px 5px;
    background-image: radial-gradient(color-mix(in oklab, var(--chroma-cyan) 70%, transparent) 0.9px, transparent 1px);
  }
  .sweep {
    position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--chroma-cyan);
    box-shadow: 0 0 22px 4px color-mix(in oklab, var(--chroma-cyan) 70%, transparent);
    animation: ab-sweep 6.2s var(--ease-in-out, cubic-bezier(0.5, 0, 0.5, 1)) infinite;
  }
  .br { position: absolute; width: 24px; height: 24px; border: 0 solid var(--chroma-cyan); animation: ab-bracket 3.4s var(--ease-out) infinite; }
  .br.tl { left: 16%; top: 24%; border-top-width: 1px; border-left-width: 1px; }
  .br.tr { right: 16%; top: 24%; border-top-width: 1px; border-right-width: 1px; animation-delay: 0.1s; }
  .br.bl { left: 16%; bottom: 34%; border-bottom-width: 1px; border-left-width: 1px; animation-delay: 0.2s; }
  .br.brr { right: 16%; bottom: 34%; border-bottom-width: 1px; border-right-width: 1px; animation-delay: 0.3s; }
  .shade {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, color-mix(in oklab, var(--void) 55%, transparent) 0, transparent 22%, transparent 55%, color-mix(in oklab, var(--void) 90%, transparent) 100%);
  }
  .id, .ghost { position: absolute; top: 12px; font: 9px var(--font-mono); letter-spacing: 0.2em; text-transform: uppercase; }
  .id { left: 12px; display: flex; flex-direction: column; gap: 3px; color: var(--chroma-cyan); }
  .id .low { color: var(--text-low); }
  .ghost { right: 12px; color: var(--status-warn); animation: ab-flicker 3.1s infinite; }
  figcaption { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; }
  .name { font-family: var(--font-display); font-size: 22px; letter-spacing: 0.04em; color: var(--text-hi); }
  .role { font: 9px var(--font-mono); letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
  .corner { position: absolute; width: 16px; height: 16px; border: 0 solid var(--chroma-cyan); }
  .c1 { top: -1px; left: -1px; border-top-width: 1px; border-left-width: 1px; }
  .c2 { bottom: -1px; right: -1px; border-bottom-width: 1px; border-right-width: 1px; }

  @keyframes ab-scanband { 0% { clip-path: inset(0 0 100% 0); } 100% { clip-path: inset(100% 0 0 0); } }
  @keyframes ab-sweep { 0% { transform: translateY(-12%); } 100% { transform: translateY(112%); } }
  @keyframes ab-bracket { 0%, 100% { opacity: 0.35; transform: scale(1); } 50% { opacity: 1; transform: scale(0.94); } }
  @keyframes ab-flicker { 0%, 48%, 52%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
  /* Stillness: no scan band, no sweep — just the photo and its mesh. */
  @media (prefers-reduced-motion: reduce) {
    .cloud, .sweep { display: none; }
    .br, .ghost { animation: none; }
  }

  /* ── partners ───────────────────────────────────────────── */
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--sp-6); flex-wrap: wrap; margin-bottom: var(--sp-7); }
  .aside { margin: 0; color: var(--text-mid); max-width: 34ch; font-size: var(--fs-body-lg); }
  .partner-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: var(--sp-4); }
  .partner-grid a {
    position: relative; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: var(--sp-5);
    background: color-mix(in oklab, var(--surface-1) 88%, transparent);
    border: 1px solid var(--border); padding: var(--sp-6); text-decoration: none;
    transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .tick { position: absolute; left: -1px; top: -1px; width: 12px; height: 12px; border-top: 1px solid var(--chroma-cyan); border-left: 1px solid var(--chroma-cyan); }
  .logo { height: 72px; display: flex; align-items: center; font-family: var(--font-display); font-size: 1.6rem; color: var(--text-hi); }
  .logo :global(img) { height: 72px; width: auto; }
  .kicker { font: 10px var(--font-mono); letter-spacing: 0.24em; text-transform: uppercase; margin-bottom: 10px; }
  .partner-grid h3 { font-family: var(--font-body); font-weight: 600; font-size: var(--fs-h4); color: var(--text-hi); margin: 0 0 8px; }
  .partner-grid p { margin: 0; color: var(--text-mid); font-size: var(--fs-sm); }
  .visit { margin-top: auto; font: 10px var(--font-mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-low); }

  /* ── contact ────────────────────────────────────────────── */
  .contact { position: relative; overflow: hidden; border-top: 1px solid var(--line-mid); background: var(--field-glow), var(--void); }
  .contact .inner { position: relative; z-index: 2; }
  dt { font: 9px var(--font-mono); letter-spacing: 0.28em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 8px; }
  .where { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: var(--sp-6); }
  .where dt { letter-spacing: 0.26em; margin-bottom: 10px; }
  .where dd { color: var(--text-hi); overflow-wrap: anywhere; }
  .where a { color: var(--accent); text-decoration: none; }
  .where a:hover { color: var(--chroma-cyan); }

  /* ── small viewports ────────────────────────────────────── */
  @media (max-width: 760px) {
    .inner { padding-left: var(--sp-4); padding-right: var(--sp-4); }
    .scan { justify-self: stretch; max-width: none; }
    .scan-tag { display: none; }
  }
</style>
