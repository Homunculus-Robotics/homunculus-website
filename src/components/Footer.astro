---
import logo from '../../design-system/assets/logo-mark-light.png';
import { NAV_LINKS, navHref } from '../lib/site';

const lang = Astro.currentLocale === 'de' ? 'de' : 'en';
const year = new Date().getFullYear();
---
<footer>
  <div class="bar">
    <div class="brand">
      <img src={logo.src} width={logo.width} height={logo.height} alt="" />
      <span>HOMUNCULUS ROBOTICS · © {year}</span>
    </div>
    <nav aria-label="Footer">
      {NAV_LINKS.map((l) => <a href={navHref(l.href, lang)}>{l.label[lang]}</a>)}
    </nav>
  </div>
</footer>

<style>
  footer { background: var(--void); }
  .bar {
    max-width: var(--maxw-wide);
    margin: 0 auto;
    padding: var(--sp-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-5);
  }

  .brand { display: flex; align-items: center; gap: 10px; }
  .brand img { height: 26px; width: auto; }
  .brand span {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--text-low);
  }

  nav { display: flex; gap: 22px; flex-wrap: wrap; }
  nav a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-low);
    text-decoration: none;
  }
  nav a:hover { color: var(--accent); }
</style>
