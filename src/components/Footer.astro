---
import logo from '../../design-system/assets/logo-mark-light.png';
import { NAV_LINKS, navHref } from '../lib/site';

const lang = Astro.currentLocale === 'de' ? 'de' : 'en';
const year = new Date().getFullYear();
---
<footer>
  <div class="bar">
    <div class="brand">
      <img src={logo.src} width={logo.width} height={logo.height} alt="" />
      <span>HOMUNCULUS ROBOTICS · © {year}</span>
    </div>
    <nav aria-label="Footer">
      {NAV_LINKS.map((l) => <a href={navHref(l.href, lang)}>{l.label[lang]}</a>)}
      <a href={navHref('/impressum', lang)}>{lang === 'de' ? 'Impressum' : 'Legal notice'}</a>
      <a href={navHref('/datenschutz', lang)}>{lang === 'de' ? 'Datenschutz' : 'Privacy'}</a>
    </nav>
    {/* Hud.astro ticks the timecode. */}
    <span class="tc" aria-hidden="true">LINK STABIL · <span data-hud-tc>00:00:00:00</span></span>
  </div>
</footer>

<style>
  footer { background: var(--void); border-top: 1px solid var(--line-mid); }
  .bar {
    max-width: var(--maxw-wide);
    margin: 0 auto;
    padding: var(--sp-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-5);
  }

  .brand { display: flex; align-items: center; gap: 10px; }
  .brand img { height: 24px; width: auto; }
  .brand span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--text-low);
  }

  nav { display: flex; gap: 20px; flex-wrap: wrap; }
  nav a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-low);
    text-decoration: none;
  }
  nav a:hover { color: var(--chroma-cyan); }

  .tc {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
</style>
