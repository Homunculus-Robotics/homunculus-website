---
import logo from '../../design-system/assets/logo-mark-light.png';
import ThemeSwitcher from './ThemeSwitcher.astro';
import LangSwitch from './LangSwitch.astro';
import { NAV_LINKS, localePath, navHref } from '../lib/site';

const lang = Astro.currentLocale === 'de' ? 'de' : 'en';
const path = localePath(Astro.url.pathname);
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header>
  <div class="bar">
    <a class="brand" href={navHref('/', lang)}>
      <img src={logo.src} width={logo.width} height={logo.height} alt="" />
      <span class="word">
        <span class="name">HOMUNCULUS</span>
        <span class="sub">ROBOTICS · KÖLN/BONN</span>
      </span>
    </a>
    <nav aria-label="Main">
      {NAV_LINKS.map((l) => (
        <a href={navHref(l.href, lang)} class:list={[isCurrent(l.href) && 'current']} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label[lang]}</a>
      ))}
    </nav>
    <div class="tools">
      <ThemeSwitcher />
      <LangSwitch />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px);
    background: color-mix(in oklab, var(--void) 72%, transparent);
    border-bottom: 1px solid var(--line-mid);
  }
  .bar {
    max-width: var(--maxw-wide);
    margin: 0 auto;
    padding: 0 var(--sp-5);
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }

  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand img { height: 30px; width: auto; }
  .word { display: flex; flex-direction: column; line-height: 1; }
  .name {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 0.04em;
    color: var(--text-hi);
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.34em;
    color: var(--chroma-cyan);
    margin-top: 3px;
  }

  /* The "01 " prefix is CSS so the link's accessible name stays the label. */
  nav {
    display: flex;
    gap: 26px;
    align-items: center;
    counter-reset: nav;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  nav a {
    color: var(--text-mid);
    text-decoration: none;
    white-space: nowrap;
    counter-increment: nav;
  }
  nav a::before { content: counter(nav, decimal-leading-zero) ' '; }
  nav a:hover { color: var(--chroma-cyan); }
  nav a.current {
    color: var(--text-hi);
    border: 1px solid var(--line-accent);
    padding: 5px 10px;
    background: color-mix(in oklab, var(--accent) 10%, transparent);
  }

  .tools { display: flex; align-items: center; gap: 14px; }

  /* The prototype has no small-viewport case; the bar simply overflows there.
     Wrapping is the smallest honest fix — a drawer is 0.3's call if it needs one. */
  @media (max-width: 900px) {
    .bar { height: auto; flex-wrap: wrap; padding: var(--sp-3) var(--sp-4); row-gap: var(--sp-3); }
    nav { order: 3; width: 100%; gap: var(--sp-5); overflow-x: auto; font-size: 10px; }
  }
</style>
