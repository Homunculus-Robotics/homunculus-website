---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  tone?: 'green' | 'gold' | 'neutral' | 'error';
  /** Adds the flickering status dot. */
  live?: boolean;
}

const { tone = 'green', live = false, class: className, ...rest } = Astro.props;
---
<span class:list={['hmc-badge', `t-${tone}`, className]} {...rest}>
  {live && <span class="dot" aria-hidden="true" />}
  <slot />
</span>

<style>
  .hmc-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid var(--badge-line);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--surface-2) 60%, transparent);
    color: var(--badge-fg);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--badge-dot);
    box-shadow: 0 0 8px var(--badge-dot);
    animation: hmc-flicker 2.4s var(--ease-out) infinite;
  }

  /* ponytail: #ffb0a8 and Button's #2a1c00 are the only literals in src/ — they
     come verbatim from the .jsx specimens and the token set has no
     --text-on-error / --text-on-signal to point at. Add those two tokens in
     design-system/tokens/colors.css and these become var() like everything else. */
  .t-green   { --badge-fg: var(--green-200); --badge-line: var(--line-green);  --badge-dot: var(--green-300); }
  .t-gold    { --badge-fg: var(--gold-300);  --badge-line: var(--line-gold);   --badge-dot: var(--gold-400); }
  .t-neutral { --badge-fg: var(--text-mid);  --badge-line: var(--line-mid);    --badge-dot: var(--text-low); }
  .t-error   { --badge-fg: #ffb0a8;          --badge-line: color-mix(in oklab, var(--status-error) 45%, transparent); --badge-dot: var(--status-error); }

  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }
</style>
