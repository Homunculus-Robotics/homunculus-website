---
// The About v2 chrome (design-system/About.dc.html): interlace, vignette,
// corner frame and the two instrument rails. Decoration only — all of it is
// aria-hidden and pointer-events: none. The rails read the page's
// `main section[id]` for the segment label and drive every `[data-par]`
// layer and `[data-hud-tc]` timecode on the page.
---
<div class="hud" aria-hidden="true">
  <div class="interlace"></div>
  <div class="vignette"></div>
  <div class="frame"><span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span></div>

  <div class="rail l">
    <div class="stack">
      <span class="led"></span>
      <span class="v cyan">SYS.TAUCHGANG</span>
    </div>
    <div class="track">
      <div class="line"></div>
      <div class="bar" data-hud-bar></div>
      <span class="v seg" data-hud-seg>SEG.00</span>
    </div>
    <div class="stack">
      <span class="v accent" data-hud-depth>000.0%</span>
      <span class="v faint">TIEFE</span>
    </div>
  </div>

  <div class="rail r">
    <span class="v low" data-hud-tc>00:00:00:00</span>
    <span class="v faint">Systemdossier · Homunculus</span>
    <div class="stack">
      <span class="v warn">NICHT ZERTIFIZIERT</span>
      <span class="blink"></span>
    </div>
  </div>
</div>

<script>
  const q = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);
  const bar = q('[data-hud-bar]');
  const seg = q('[data-hud-seg]');
  const depth = q('[data-hud-depth]');
  const tcs = [...document.querySelectorAll<HTMLElement>('[data-hud-tc]')];
  const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
  const layers = [...document.querySelectorAll<HTMLElement>('[data-par]')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number, w = 2) => String(Math.floor(n)).padStart(w, '0');
  const mouse = { x: 0, y: 0 };
  let raf = 0;

  function paint() {
    raf = 0;
    const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const p = Math.min(1, Math.max(0, scrollY / max));
    if (depth) depth.textContent = (p * 100).toFixed(1).padStart(5, '0') + '%';
    if (bar) bar.style.height = (p * 100).toFixed(2) + '%';
    let label = '';
    sections.forEach((el, i) => {
      if (el.getBoundingClientRect().top < innerHeight * 0.45) label = `${pad(i)} · ${el.id.toUpperCase()}`;
    });
    if (label && seg && seg.textContent !== label) seg.textContent = label;
    if (!still) {
      for (const el of layers) {
        const d = Number(el.dataset.par) || 0;
        el.style.translate = `${(-mouse.x * d).toFixed(1)}px ${(-mouse.y * d * 0.6).toFixed(1)}px`;
      }
    }
  }
  const queue = () => { raf ||= requestAnimationFrame(paint); };

  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue, { passive: true });
  if (!still && layers.length) {
    addEventListener('mousemove', (e) => {
      mouse.x = (e.clientX / (innerWidth || 1) - 0.5) * 2;
      mouse.y = (e.clientY / (innerHeight || 1) - 0.5) * 2;
      queue();
    }, { passive: true });
  }
  queue();

  // SMPTE-style timecode since page load, 25 fps.
  const t0 = Date.now();
  setInterval(() => {
    const s = (Date.now() - t0) / 1000;
    const tc = `${pad(s / 3600)}:${pad((s / 60) % 60)}:${pad(s % 60)}:${pad((s * 25) % 25)}`;
    for (const el of tcs) el.textContent = tc;
  }, 200);
</script>

<style>
  .hud > * { position: fixed; pointer-events: none; }

  /* Moves by transform, not background-position, so it stays on the compositor. */
  .interlace {
    inset: -6px 0 0;
    z-index: 60;
    background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.3) 2px 3px) 0 0 / 100% 6px;
    opacity: 0.5;
    mix-blend-mode: multiply;
    animation: hud-interlace 1.6s linear infinite;
  }
  .vignette { inset: 0; z-index: 59; box-shadow: inset 0 0 180px 40px rgba(0, 0, 0, 0.85); }

  .frame { inset: 10px; z-index: 58; }
  .frame span { position: absolute; width: 20px; height: 20px; border: 0 solid var(--chroma-cyan); opacity: 0.8; }
  .frame .tl { left: 0; top: 0; border-top-width: 1px; border-left-width: 1px; }
  .frame .tr { right: 0; top: 0; border-top-width: 1px; border-right-width: 1px; }
  .frame .bl { left: 0; bottom: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .frame .br { right: 0; bottom: 0; border-bottom-width: 1px; border-right-width: 1px; }

  .rail {
    top: 0;
    bottom: 0;
    width: 44px;
    z-index: 57;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
    background: color-mix(in oklab, var(--void) 70%, transparent);
  }
  .rail.l { left: 0; border-right: 1px solid var(--border-quiet); }
  .rail.r { right: 0; border-left: 1px solid var(--border-quiet); }
  .stack { display: flex; flex-direction: column; align-items: center; gap: 10px; }

  .v {
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .cyan { color: var(--chroma-cyan); letter-spacing: 0.34em; }
  .accent { color: var(--accent); letter-spacing: 0.24em; }
  .low { color: var(--text-low); letter-spacing: 0.24em; }
  .faint { color: var(--text-faint); }
  .warn { color: var(--status-warn); }

  .led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--chroma-cyan);
    box-shadow: 0 0 10px var(--chroma-cyan);
    animation: hud-flicker 2.4s infinite;
  }
  .blink { width: 5px; height: 5px; background: var(--status-warn); animation: hud-blink 1.1s steps(1, end) infinite; }

  .track { flex: 1; width: 100%; margin: 16px 0; position: relative; display: flex; align-items: center; justify-content: center; }
  .line, .bar { position: absolute; top: 0; left: 50%; width: 1px; }
  .line { bottom: 0; background: var(--border); }
  .bar { height: 0; background: var(--chroma-cyan); box-shadow: 0 0 8px var(--chroma-cyan); }
  .seg { position: relative; color: var(--text-low); letter-spacing: 0.28em; background: var(--void); padding: 8px 0; }

  /* The rails eat 88px of width; the prototype never goes below desktop. */
  @media (min-width: 761px) {
    :global(body) { padding-inline: 44px; }
  }
  @media (max-width: 760px) {
    .rail { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .interlace, .led, .blink { animation: none; }
  }

  @keyframes hud-interlace { to { transform: translateY(6px); } }
  @keyframes hud-flicker { 0%, 48%, 52%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
  @keyframes hud-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.15; } }
</style>
