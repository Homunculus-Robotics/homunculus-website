---
// The drifting sketch layer behind About v2's hero and newsletter sections.
// `hero`: spinning mark, unicycle right, actuator bottom-left, two hairlines.
// `center`: the unicycle alone, centred. The parent must be position:relative.
// <Image> re-encodes the design-system PNGs to WebP (sharp ships with Astro), so
// the 1.3 MB unicycle is not what the hero downloads.
import { Image } from 'astro:assets';
import logo from '../../design-system/assets/logo-mark-light.png';
import unicycle from '../../design-system/assets/sketch-unicycle-exploded.png';
import actuator from '../../design-system/assets/sketch-actuator-exploded.png';

interface Props {
  variant?: 'hero' | 'center';
}
const { variant = 'hero' } = Astro.props;
// The unicycle is sized by the section's height (about 1000 CSS px), not by the
// viewport, so one fixed width covers it; the actuator draws at ~15% width.
const img = { alt: '', fetchpriority: 'low' } as const;
---
<div class:list={['backdrop', variant]} aria-hidden="true">
  {variant === 'hero' ? (
    <>
      <Image {...img} data-par="26" class="mark" src={logo} />
      <Image {...img} data-par="14" class="uni" src={unicycle} width={800} />
      <Image {...img} data-par="40" class="act" src={actuator} width={480} />
      <div class="hairlines"></div>
    </>
  ) : (
    <Image {...img} data-par="20" class="uni" src={unicycle} width={800} />
  )}
</div>

<style>
  .backdrop { position: absolute; inset: -6%; z-index: 0; pointer-events: none; }
  .center { inset: 0; }
  img { position: absolute; height: auto; }

  .mark { left: -6%; top: -14%; width: 46%; opacity: 0.05; animation: bd-spin 240s linear infinite; }
  .uni { height: 100%; width: auto; filter: invert(1) hue-rotate(180deg); }
  .hero .uni { right: -4%; top: 0; opacity: 0.22; }
  .center .uni { left: 50%; top: 0; transform: translateX(-50%); opacity: 0.14; }
  .act { left: 2%; bottom: 4%; width: 15%; opacity: 0.16; }

  .hairlines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(115deg, transparent 0 46%, color-mix(in oklab, var(--chroma-cyan) 12%, transparent) 46% 46.1%, transparent 46.1% 100%),
      linear-gradient(115deg, transparent 0 63%, color-mix(in oklab, var(--paper) 6%, transparent) 63% 63.08%, transparent 63.08% 100%);
  }

  @media (max-width: 760px) { .hero .uni { opacity: 0.1; } }

  @keyframes bd-spin { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .mark { animation: none; } }
</style>
